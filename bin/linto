#!/bin/sh
# linto -- command-line entry point for the local Linux Tools collection.

set -eu

bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
script_dir=$(CDPATH= cd -- "$bin_dir/.." && pwd -P)

is_group_name() {
  case "$1" in
    ''|.*|bin|completions|man|tests|lib) return 1 ;;
    *[!a-zA-Z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

list_groups() {
  [ -f "$script_dir/config.yml" ] || return 0
  python3 "$script_dir/lib/config.py" "$script_dir/config.yml" list
}

list_group_commands() {
  group=$1
  for tool in "$script_dir/$group"/*.sh; do
    [ -f "$tool" ] && [ -x "$tool" ] || continue
    name=${tool##*/}
    printf '%s\n' "${name%.sh}"
  done
}

list_groups_and_commands() {
  for group in $(list_groups); do
    printf '%s\n' "$group"
    list_group_commands "$group" | sed 's/^/  /'
  done
}

group_exists() {
  is_group_name "$1" && [ -d "$script_dir/$1" ] &&
    list_groups | grep -Fxq -- "$1"
}

find_group_command() {
  group=$1
  command_name=$2
  for candidate in "$script_dir/$group/$command_name" "$script_dir/$group/$command_name.sh"; do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

render_guide() {
  guide_page=$1
  if [ -n "${LINTO_MDVIEWER:-}" ]; then
    viewers=$LINTO_MDVIEWER
  elif [ -f "$script_dir/config.yml" ]; then
    viewers=$(python3 "$script_dir/lib/config.py" "$script_dir/config.yml" markdown-viewer 2>/dev/null || true)
  else
    viewers=cat
  fi

  selected=
  while IFS= read -r viewer; do
    [ -n "$viewer" ] || continue
    case "$viewer" in
      cat) selected=cat; break ;;
      md-tui|inlyne|mdcat|mandown|glow|frogmouth|bat|mdfried|mdless)
        if command -v "$viewer" >/dev/null 2>&1 &&
           { [ "$viewer" != mandown ] || command -v groff >/dev/null 2>&1; }; then
          selected=$viewer
          break
        fi
        ;;
      *)
        printf 'linto: unsupported Markdown viewer: %s\n' "$viewer" >&2
        ;;
    esac
  done <<EOF
$viewers
EOF
  viewer=${selected:-cat}

  case "$viewer" in
    md-tui|inlyne|mdcat|glow|frogmouth|mdfried)
      "$viewer" "$guide_page"
      ;;
    mdless)
      if command -v mdless >/dev/null 2>&1; then
        mdless "$guide_page"
      else
        cat "$guide_page"
      fi
      ;;
    mandown)
      if command -v mandown >/dev/null 2>&1 && command -v groff >/dev/null 2>&1; then
        mandown "$guide_page" "LINTO-GUIDE" 1 | groff -Tutf8 -man
      else
        cat "$guide_page"
      fi
      ;;
    bat)
      if command -v bat >/dev/null 2>&1; then
        bat --language markdown --style plain "$guide_page"
      else
        cat "$guide_page"
      fi
      ;;
    cat|'')
      cat "$guide_page"
      ;;
    *)
      printf 'linto: unsupported Markdown viewer: %s\n' "$viewer" >&2
      cat "$guide_page"
      ;;
  esac
}

find_tool() {
  command_name=$1
  group=${2-}
  if [ -n "$group" ]; then
    for candidate in "$script_dir/$group/$command_name" "$script_dir/$group/$command_name.sh"; do
      if [ -f "$candidate" ]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
    return 1
  fi

  for candidate in \
    "$script_dir/$command_name" \
    "$script_dir/$command_name.sh" \
    "$script_dir"/*/"$command_name" \
    "$script_dir"/*/"$command_name.sh"
  do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

usage() {
  cat <<EOF
Usage: linto [--help] [COMMAND [arguments...]]
       linto [--help] GROUP COMMAND [arguments...]
       linto-GROUP [COMMAND [arguments...]]
       linto-GROUP-COMMAND [arguments...]

Linux Tools: bibliography, Quarto, text, and shell utilities.

Commands:
  help [PAGE|GROUP [COMMAND]]  Show a guide page or command help.
  help page PAGE               Show a guide page, even if its name is a group.
  completion SHELL        Print shell completion setup instructions.
  --list-groups           Print group names, one per line.
  --list-commands GROUP   Print commands in GROUP, one per line.
  GROUP [COMMAND...]      Run a command in GROUP or list its commands.
  linto-GROUP [COMMAND]   Group alias; linto-GROUP-COMMAND runs a tool directly.
  COMMAND [ARGUMENTS...]  Run a tool by its command name.

Groups:
EOF
  list_groups | sed 's/^/  /'
  cat <<EOF

Available commands, grouped by folder (also available without the group):
EOF
  list_groups_and_commands
  cat <<EOF

EOF
}


# Examples:
#   linto stripaccents --min 4 --max 20 'Été à Paris'
#   linto stripaccents --file 'Documents/Été à Paris.Final.PDF'
#   linto stripaccents --dir 'Documents/Été à Paris'
#   linto quarto-render --help
#   linto prettyprint
#   linto utils prettyprint
#   linto-utils
#   linto-utils prettyprint
#   linto-utils-prettyprint
#   linto-utils-stripaccents
#   linto-quarto-render
#   linto quarto citations --order-by key --format csv report.qmd

if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

case "$1" in
  --list-groups)
    [ "$#" -eq 1 ] || { echo "Usage: linto --list-groups" >&2; exit 2; }
    list_groups
    exit 0
    ;;
  --list-commands)
    [ "$#" -eq 2 ] && group_exists "$2" || { echo "Usage: linto --list-commands GROUP" >&2; exit 2; }
    list_group_commands "$2"
    exit 0
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  help)
    if [ "$#" -eq 1 ]; then
      render_guide "$script_dir/linto-guide/index.md"
      exit 0
    elif [ "$#" -eq 3 ] && [ "$2" = page ]; then
      topic=$3
      case "$topic" in
        installation) topic=install ;;
        configuration) topic=config ;;
      esac
      guide_page="$script_dir/linto-guide/$topic.md"
      if [ -f "$guide_page" ]; then
        render_guide "$guide_page"
        exit 0
      fi
      printf 'linto: unknown guide page: %s\n' "$topic" >&2
      exit 2
    elif [ "$#" -eq 2 ]; then
      topic=$2
      case "$topic" in
        installation) topic=install ;;
        configuration) topic=config ;;
      esac
      if group_exists "$topic"; then
        guide_page="$script_dir/linto-guide/$topic.md"
        if [ -f "$guide_page" ]; then
          render_guide "$guide_page"
          printf '\n'
        fi
        echo "Commands in group '$topic':"
        list_group_commands "$topic" | sed 's/^/  /'
        exit 0
      fi
      guide_page="$script_dir/linto-guide/$topic.md"
      if [ -f "$guide_page" ]; then
        render_guide "$guide_page"
        exit 0
      fi
      group=
      command=$2
    elif [ "$#" -eq 3 ]; then
      group=$2
      command=$3
    else
      echo "Usage: linto help [PAGE|GROUP [COMMAND]] | linto help page PAGE" >&2
      exit 2
    fi
    case "$command" in
      slug) command=stripaccents ;;
    esac
    if ! tool=$(find_tool "$command" "$group"); then
      echo "linto: unknown command: $command" >&2
      usage >&2
      exit 2
    fi
    if [ ! -x "$tool" ]; then
      echo "linto: command is not executable: $command" >&2
      exit 1
    fi
    exec "$tool" --help
    ;;
  completion)
    if [ "$#" -ne 2 ]; then
      echo "Usage: linto completion {bash|zsh|fish}" >&2
      exit 2
    fi
    case "$2" in
      bash)
        printf 'source "%s/completions/linto.bash"\n' "$script_dir/completions"
        ;;
      zsh)
        printf 'fpath=("%s/completions" $fpath)\nautoload -Uz compinit && compinit\n' "$script_dir/completions"
        ;;
      fish)
        printf 'source "%s/completions/linto.fish"\n' "$script_dir/completions"
        ;;
      *)
        echo "linto: unsupported completion shell: $2 (choose bash, zsh, or fish)" >&2
        exit 2
        ;;
    esac
    exit 0
    ;;
  *)
    first=$1
    shift
    case "$first" in
      slug) first=stripaccents ;;
    esac

    case "$first" in
      linto-*-*)
        encoded=${first#linto-}
        encoded_group=${encoded%%-*}
        encoded_command=${encoded#*-}
        if group_exists "$encoded_group" && [ "$encoded_command" != "$encoded" ]; then
          if tool=$(find_group_command "$encoded_group" "$encoded_command") && [ -x "$tool" ]; then
            exec "$tool" "$@"
          fi
          echo "linto: unknown command '$encoded_command' in group '$encoded_group'" >&2
          exit 2
        fi
        ;;
      linto-*)
        encoded_group=${first#linto-}
        if group_exists "$encoded_group"; then
          first=$encoded_group
        fi
        ;;
    esac

    if group_exists "$first"; then
      group=$first
      if [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --help ]; }; then
        guide_page="$script_dir/linto-guide/$group.md"
        if [ -f "$guide_page" ]; then
          render_guide "$guide_page"
          printf '\n'
        fi
        printf 'Commands in group %s:\n' "$group"
        list_group_commands "$group" | sed 's/^/  /'
        exit 0
      fi
      command=$1
      shift
    else
      group=
      command=$first
    fi
    case "$command" in
      slug) command=stripaccents ;;
    esac
    if tool=$(find_tool "$command" "$group") && [ -x "$tool" ]; then
      exec "$tool" "$@"
    fi
    if [ -n "$group" ]; then
      echo "linto: unknown command '$command' in group '$group'" >&2
    else
      echo "linto: unknown command: $command" >&2
    fi
    usage >&2
    exit 2
    ;;
esac
