"    enable = true;\n"
"    # Réglages facultatifs pour tout le système, écrits dans /etc/linto/linto.yml :\n"
"    # settings.groups.quarto.configdata.extension = \"chris2fr/quarto\";\n"
"  };\n"
"\n"
