msgid ""
"Usage: linto linto build [-h|--help]\n"
"\n"
"Build the user-level group/command and shortcut wrappers, the Fish completion,\n"
"and the man pages from the current configuration. Generated files are written\n"
"under the user's Linto data directory (XDG_DATA_HOME); the installation tree is\n"
"read-only.\n"
"\n"
"Options:\n"
"  -h, --help  Show this help and exit."
msgstr ""
"Usage: linto linto build [-h|--help]\n"
"\n"
"Construit les wrappers de groupes, de commandes et de raccourcis de\n"
"l'utilisateur, la complétion Fish et les pages de manuel à partir de la\n"
"configuration actuelle. Les fichiers générés sont écrits dans le répertoire de\n"
"données Linto de l'utilisateur (XDG_DATA_HOME) ; l'arbre d'installation reste en\n"
"lecture seule.\n"
"\n"
"Options :\n"
"  -h, --help  Affiche cette aide et quitte."

msgid "%s not found: guide man pages are skipped (run linto linto mdsetup)"
msgstr "%s introuvable : les pages de manuel du guide sont ignorées (lancez linto linto mdsetup)"

msgid "Built %d active group(s), wrappers, completions, dispatcher man page, and %d guide topic man page(s)."
msgstr "Construit : %d groupe(s) actif(s), wrappers, complétions, page de manuel du répartiteur et %d page(s) de manuel de sujets du guide."

msgid ""
"Usage: linto linto rmgroup [-h|--help] GROUP\n"
"\n"
"Disable a command group in the user's Linto configuration without deleting its\n"
"installed or user data directory. Generated wrappers and completions are\n"
"reconciled by build.\n"
"\n"
"Options:\n"
"  -h, --help  Show this help and exit."
msgstr ""
"Usage: linto linto rmgroup [-h|--help] GROUPE\n"
"\n"
"Désactive un groupe de commandes dans la configuration Linto de l'utilisateur\n"
"sans supprimer son répertoire installé ou utilisateur. Les wrappers et\n"
"complétions générés sont réconciliés par build.\n"
"\n"
"Options :\n"
"  -h, --help  Affiche cette aide et quitte."

