"\n"
"  imports = [ inputs.linto.nixosModules.default ];\n"
"  programs.linto = {\n"
"    enable = true;\n"
"    # Optional system-wide settings, written to /etc/linto/linto.yml:\n"
"    # settings.groups.quarto.configdata.extension = \"chris2fr/quarto\";\n"
"  };\n"
"\n"
