#compdef linto

_linto() {
  local -a commands groups group_commands aliases
  local group linto_bin completion_file
  local -a reply
  local kind patterns
  completion_file=${${funcsourcetrace[1]%%:*}:A}
  if [[ "$completion_file" == */completions/_linto ]]; then
    linto_bin="${completion_file:h:h}/bin/linto"
  else
    linto_bin="${commands[linto]:A}"
  fi
  groups=(${(f)"$("$linto_bin" --list-groups 2>/dev/null)"})
  commands=(${(f)"$("$linto_bin" --list-shortcuts 2>/dev/null)"})


  # Past the command name, ask the dispatcher what the command's arguments
  # look like (see lib/complete.py); it prints nothing while the cursor is still
  # on a group or command name.
  if (( CURRENT >= 3 )) && [[ $words[2] != (help|completion) ]]; then
    reply=("${(@f)$("$linto_bin" --complete "${(@)words[2,CURRENT]}" 2>/dev/null)}")
    if [[ -n $reply[1] ]]; then
      kind=${reply[1]%%$'\t'*}
      patterns=
      [[ $reply[1] == *$'\t'* ]] && patterns=${reply[1]#*$'\t'}
      case $kind in
        files)
          if [[ -n $patterns ]]; then
            _files -g "${patterns//,/ }"
          else
            _files
          fi
          ;;
        dirs) _files -/ ;;
        words)
          # Words may carry a description after a tab: "word<TAB>description".
          local -a described
          local item
          for item in "${(@)reply[2,-1]}"; do
            if [[ $item == *$'\t'* ]]; then
              described+=("${item%%$'\t'*}:${item#*$'\t'}")
            else
              described+=("$item")
            fi
          done
          _describe 'argument' described
          ;;
        *) return 1 ;;
      esac
      return
    fi
  fi

  if (( CURRENT == 2 )); then
    aliases=(linto-${^groups} linto-${^commands})
    _describe 'linto command' commands
    _describe 'linto group' groups
    _describe 'group alias' aliases
    _values 'special command' help completion
  elif [[ $words[2] == completion ]] && (( CURRENT == 3 )); then
    _values 'shell' bash zsh fish
  elif [[ $words[2] == help ]]; then
    if (( CURRENT == 3 )); then
      _describe 'group' groups
      _describe 'command' commands
    elif (( CURRENT == 4 )); then
      group=$words[3]
      group_commands=(${(f)"$("$linto_bin" --list-commands "$group" 2>/dev/null)"})
      _describe "$group command" group_commands
    fi
  elif [[ $words[2] == linto-* ]]; then
    group=${words[2]#linto-}
    if [[ $group == *-* ]]; then
      _arguments '*:argument: '
    elif (( CURRENT == 3 )); then
      group_commands=(${(f)"$("$linto_bin" --list-commands "$group" 2>/dev/null)"})
      _describe "$group command" group_commands
    else
      _arguments '*:argument: '
    fi
  elif (( ${groups[(Ie)$words[2]]} )); then
    group=$words[2]
    if (( CURRENT == 3 )); then
      group_commands=(${(f)"$("$linto_bin" --list-commands "$group" 2>/dev/null)"})
      _describe "$group command" group_commands
    elif (( CURRENT > 3 )); then
      _files
    else
      _arguments '(-h --help)'{-h,--help}'[Show help]'
    fi
  elif (( CURRENT == 3 )); then
    _arguments '(-h --help)'{-h,--help}'[Show help]'
  else
    _arguments '*:argument: '
  fi
}

_linto "$@"
