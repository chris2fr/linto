#compdef linto

_linto() {
  local -a commands groups group_commands aliases
  local group linto_bin completion_file
  completion_file=${${funcsourcetrace[1]%%:*}:A}
  if [[ "$completion_file" == */completions/_linto ]]; then
    linto_bin="${completion_file:h:h}/bin/linto"
  else
    linto_bin="${commands[linto]:A}"
  fi
  groups=(${(f)"$("$linto_bin" --list-groups 2>/dev/null)"})
  commands=(${(f)"$("$linto_bin" --list-shortcuts 2>/dev/null)"})


  if [[ "$words[1]" == linto && "$words[2]" == zed && $CURRENT -ge 3 ]]; then
    _files
  elif (( CURRENT == 2 )); then
    aliases=(linto-${^groups} linto-${^commands})
    _describe 'linto command' commands
    _describe 'linto group' groups
    _describe 'group alias' aliases
    _values 'special command' help completion
  elif [[ $words[2] == completion ]] && (( CURRENT == 3 )); then
    _values 'shell' bash zsh fish
  elif [[ $words[2] == help ]]; then
    if (( CURRENT == 3 )); then
      _describe 'group' groups
      _describe 'command' commands
    elif (( CURRENT == 4 )); then
      group=$words[3]
      group_commands=(${(f)"$("$linto_bin" --list-commands "$group" 2>/dev/null)"})
      _describe "$group command" group_commands
    fi
  elif [[ $words[2] == linto-* ]]; then
    group=${words[2]#linto-}
    if [[ $group == *-* ]]; then
      _arguments '*:argument: '
    elif (( CURRENT == 3 )); then
      group_commands=(${(f)"$("$linto_bin" --list-commands "$group" 2>/dev/null)"})
      _describe "$group command" group_commands
    else
      _arguments '*:argument: '
    fi
  elif (( ${groups[(Ie)$words[2]]} )); then
    group=$words[2]
    if (( CURRENT == 3 )); then
      group_commands=(${(f)"$("$linto_bin" --list-commands "$group" 2>/dev/null)"})
      _describe "$group command" group_commands
    elif (( CURRENT > 3 )); then
      _files
    else
      _arguments '(-h --help)'{-h,--help}'[Show help]'
    fi
  elif (( CURRENT == 3 )); then
    _arguments '(-h --help)'{-h,--help}'[Show help]'
  else
    _arguments '*:argument: '
  fi
}

_linto "$@"
